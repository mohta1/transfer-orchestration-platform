{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "task_id",
    "summary",
    "blockers",
    "non_blocking_improvements",
    "preferences",
    "acceptance_criteria_checked"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{2}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "category",
          "reason",
          "files",
          "required_fix"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "challenge_mismatch",
              "cross_file_conflict",
              "architecture_violation",
              "financial_correctness",
              "external_payment_semantics",
              "messaging_reliability",
              "persistence",
              "test_integrity",
              "security",
              "regression",
              "acceptance_criteria"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required_fix": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "non_blocking_improvements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "preferences": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance_criteria_checked": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "passed",
          "evidence"
        ],
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
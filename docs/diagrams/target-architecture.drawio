        <mxCell id="note1" value="&lt;b&gt;Architecture rule&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bounded Context ≠ Microservice.&lt;br&gt;Module ≠ deployment unit.&lt;br&gt;Shared PostgreSQL instance ≠ shared data ownership.&lt;br&gt;No arbitrary cross-module table access." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">

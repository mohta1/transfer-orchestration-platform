            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_cancel_5" value="Cancel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#7F7F7F;strokeWidth=1.2;dashed=1;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="PendingFraudScreening" target="Cancelled">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1455.0" y="1240" />
              <mxPoint x="1480" y="1240" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_cancel_6" value="Cancel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#7F7F7F;strokeWidth=1.2;dashed=1;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="PendingBalanceReservation" target="Cancelled">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1815.0" y="1240" />
              <mxPoint x="1480" y="1240" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_cancel_7" value="Cancel + release Reservation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#7F7F7F;strokeWidth=1.2;dashed=1;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="BalanceReserved" target="Cancelled">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2152.5" y="1240" />
              <mxPoint x="1480" y="1240" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="note_rules" value="&lt;b&gt;State-machine invariants&lt;/b&gt;&lt;br&gt;• Invalid transitions are rejected.&lt;br&gt;• Completed cannot be resubmitted or completed again.&lt;br&gt;• FraudRejected cannot continue through the normal flow.&lt;br&gt;• External submission requires Fraud Approval + successful Balance Reservation.&lt;br&gt;• Payment timeout is not Rejection and must not trigger blind resubmission." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="90" y="1580" width="720" height="235" as="geometry" />
        </mxCell>
        <mxCell id="note_reservation" value="&lt;b&gt;Reservation side effect&lt;/b&gt;&lt;br&gt;Transfer state and Reservation state are distinct models. Reject/Cancel releases an active Reservation; successful Settlement consumes it. The Reservation is not auto-released while SubmissionStatusUnknown." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="900" y="1580" width="700" height="190" as="geometry" />
        </mxCell>
        <mxCell id="note_manual" value="&lt;b&gt;Manual recovery&lt;/b&gt;&lt;br&gt;ManualReviewRequired suspends automatic progression. Any resolution must be explicit, authorised and auditable. The exact role/approval matrix is a business/security decision." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1690" y="1580" width="650" height="190" as="geometry" />
        </mxCell>
        <mxCell id="note_limit" value="&lt;b&gt;Daily Limit&lt;/b&gt;&lt;br&gt;The Challenge state vocabulary has no dedicated PendingLimit state. Therefore the limit decision is represented on the transition from Authorised to PendingFraudScreening; a rejection terminates the normal flow." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="2430" y="1580" width="770" height="190" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Blue = normal lifecycle&lt;br&gt;Purple = waiting/pending external decision&lt;br&gt;Green = financially protected/success&lt;br&gt;Orange = recovery/manual/unknown&lt;br&gt;Red = explicit failure state&lt;br&gt;Grey = terminal non-success&lt;br&gt;Green dashed = Internal Bank variation&lt;br&gt;Grey dashed = cancellation path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#A6A6A6;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="90" y="1870" width="560" height="230" as="geometry" />
        </mxCell>
        <mxCell id="note_terminal" value="&lt;b&gt;Terminal states used here&lt;/b&gt;&lt;br&gt;`ValidationFailed`, `Rejected`, `Cancelled`, and `Completed` are terminal for normal commands. `FraudRejected` is an explicit failure state that finalises into `Rejected`. `CompensationRequired` and `ManualReviewRequired` are recovery states, not successful terminal outcomes." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="750" y="1870" width="980" height="185" as="geometry" />
        </mxCell>
        <mxCell id="note_scope" value="&lt;b&gt;Scope&lt;/b&gt;&lt;br&gt;The Domestic Interbank path is shown in full because it includes Payment Network submission, ambiguous timeout, Settlement, and Reconciliation. Internal Bank Transfer shares validation/authorisation/limit/fraud/reservation, then uses internal settlement and bypasses PendingExternalSubmission / SubmissionStatusUnknown / SettlementPending." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1840" y="1870" width="1360" height="185" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
        <mxCell id="workers" value="&lt;b&gt;.NET Hosted BackgroundServices&lt;/b&gt;&lt;br&gt;Outbox Publisher · Process / Fraud / Reconciliation workers&lt;br&gt;durable retries (stuck-transfer **query** is on-demand — TASK-20)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EADCF8;strokeColor=#8E7CC3;fontSize=11;fontStyle=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="610" y="1130" width="960" height="125" as="geometry" />

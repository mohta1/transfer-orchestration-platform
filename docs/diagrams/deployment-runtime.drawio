        <mxCell id="app_note" value="&lt;b&gt;Important&lt;/b&gt;&lt;br&gt;Module / Bounded Context boundaries are code + ownership boundaries.&lt;br&gt;They are NOT separate containers or Microservices in the initial deployment." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="610" y="1280" width="960" height="85" as="geometry" />
        </mxCell>
        <mxCell id="postgres_container" value="&lt;b&gt;PostgreSQL Container&lt;/b&gt;" style="swimlane;html=1;rounded=1;startSize=42;horizontal=1;fillColor=#D9EAF7;strokeColor=#3D85C6;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1740" y="310" width="450" height="1080" as="geometry" />
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;module-owned tables/schemas&lt;br&gt;&lt;br&gt;Transfers&lt;br&gt;TransferProcessState&lt;br&gt;Accounts&lt;br&gt;BalanceReservations&lt;br&gt;IdempotencyRecords&lt;br&gt;OutboxMessages&lt;br&gt;ProcessedMessages&lt;br&gt;ReconciliationRecords&lt;br&gt;OperationsAuditRecords" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#D9EAD3;strokeColor=#6AA84F;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1810" y="430" width="310" height="400" as="geometry" />
        </mxCell>
        <mxCell id="db_note" value="&lt;b&gt;Persistence rules&lt;/b&gt;&lt;br&gt;• local transactions&lt;br&gt;• optimistic concurrency for Aggregates&lt;br&gt;• DB constraints for financial/idempotency invariants&lt;br&gt;• Outbox claiming may use FOR UPDATE SKIP LOCKED" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1785" y="900" width="360" height="185" as="geometry" />
        </mxCell>
        <mxCell id="durability_note" value="&lt;b&gt;Durability&lt;/b&gt;&lt;br&gt;Pending process, retry, reconciliation and Outbox work survives app restart because work state is persisted here." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1785" y="1130" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="auth" value="&lt;b&gt;Customer Authorisation&lt;/b&gt;&lt;br&gt;external/supporting dependency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#C0504D;fontSize=11;fontStyle=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="2450" y="240" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="fraud" value="&lt;b&gt;Fraud &amp;amp; Compliance&lt;/b&gt;&lt;br&gt;external/supporting dependency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#C0504D;fontSize=11;fontStyle=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="2450" y="400" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="network" value="&lt;b&gt;Domestic Payment Network&lt;/b&gt;&lt;br&gt;real integration out of challenge scope&lt;br&gt;adapter/stub in implementation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#C0504D;fontSize=11;fontStyle=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="2450" y="590" width="300" height="125" as="geometry" />
        </mxCell>
        <mxCell id="provider" value="&lt;b&gt;Notification Provider&lt;/b&gt;&lt;br&gt;adapter/stub acceptable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#C0504D;fontSize=11;fontStyle=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="2450" y="790" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="legacy" value="&lt;b&gt;Legacy Banking System&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;TARGET / FUTURE coexistence — not implemented in challenge runtime&lt;/font&gt;&lt;br&gt;access via ACL / explicit integration when built" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7E6E6;strokeColor=#7F6000;fontSize=11;fontStyle=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="2450" y="990" width="300" height="135" as="geometry" />
        </mxCell>
        <mxCell id="future" value="&lt;b&gt;Future / not in challenge runtime&lt;/b&gt;&lt;br&gt;RabbitMQ/Kafka may later sit behind Outbox publisher.&lt;br&gt;Prometheus/Grafana monitoring stack not implemented (structured logs + operator query only)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="2440" y="1260" width="480" height="150" as="geometry" />
        </mxCell>
        <mxCell id="runtime_rules" value="&lt;b&gt;Runtime guarantees demonstrated by this topology&lt;/b&gt;&lt;br&gt;1. API and workers may restart without losing persisted workflow work.&lt;br&gt;2. Business state + Outbox are committed atomically in PostgreSQL.&lt;br&gt;3. Outbox delivery is at-least-once; consumers are idempotent.&lt;br&gt;4. Payment timeout enters durable Reconciliation rather than blind retry.&lt;br&gt;5. Notification failure does not roll back a completed Transfer.&lt;br&gt;6. No synchronous distributed transaction is required." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="420" y="1660" width="1900" height="250" as="geometry" />
        </mxCell>
        <mxCell id="nong_oals" value="&lt;b&gt;Intentional non-goals in this initial deployment&lt;/b&gt;&lt;br&gt;No Kubernetes · no service-per-module deployment · no Kafka/RabbitMQ requirement · no production-grade external banking/fraud/auth platform implementation." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="2420" y="1570" width="540" height="150" as="geometry" />
        </mxCell>

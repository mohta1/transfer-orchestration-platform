        <mxCell id="note_http" value="&lt;b&gt;HTTP boundary&lt;/b&gt;&lt;br&gt;The customer receives an accepted-for-processing response after durable creation/claiming. The long-running workflow continues from persisted Process State." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="65" y="520" width="420" height="105" as="geometry" />
        </mxCell>
        <mxCell id="note_guard" value="&lt;b&gt;External-submission guard&lt;/b&gt;&lt;br&gt;Domestic Interbank submission is allowed only after Fraud Approved + successful Balance Reservation." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1550" y="1360" width="390" height="105" as="geometry" />
        </mxCell>
        <mxCell id="note_accept" value="&lt;b&gt;Important&lt;/b&gt;&lt;br&gt;Submission Accepted ≠ Settlement.&lt;br&gt;Reservation remains active while Settlement is pending." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="2510" y="1615" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="note_complete" value="&lt;b&gt;Completion rule&lt;/b&gt;&lt;br&gt;Settlement confirmation leads to Reservation consumption first; then Transfer completion is persisted atomically with the Outbox Message." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1800" y="2070" width="500" height="115" as="geometry" />
        </mxCell>
        <mxCell id="note_delivery" value="&lt;b&gt;Reliable messaging&lt;/b&gt;&lt;br&gt;Publication is at-least-once. Duplicate delivery is expected; the Notification consumer uses durable ProcessedMessages deduplication." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="2780" y="2140" width="560" height="110" as="geometry" />

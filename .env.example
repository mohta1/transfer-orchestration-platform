# Copy this file to `.env` and replace the placeholder values for local Docker Compose.
# The real `.env` file is gitignored and must never be committed.

# PostgreSQL credentials shared by the postgres, migrate, and api services.
POSTGRES_PASSWORD=replace-with-local-development-password

# JWT signing key for local API authentication (minimum 32 characters).
JWT_SIGNING_KEY=replace-with-local-dev-only-32-byte-signing-key

PostgreSQL runs on the internal Compose network. Use `docker compose exec postgres psql -U transfer_app -d transfer_orchestration` for ad hoc access from the host.
